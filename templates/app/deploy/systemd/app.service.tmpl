# /etc/systemd/system/{{.Name}}.service — review before installing.
[Unit]
Description={{.Name}} (GoStack)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{.Name}}
Group={{.Name}}
StateDirectory={{.Name}}
WorkingDirectory=/var/lib/{{.Name}}
ExecStart=/opt/{{.Name}}/current/{{.Name}} --config /etc/{{.Name}}/gostack.yaml serve
Environment=GOSTACK_ENVIRONMENT=production
Environment=GOSTACK_DATABASE_PATH=/var/lib/{{.Name}}/app.db
Environment=GOSTACK_DATABASE_ANALYTICS_PATH=/var/lib/{{.Name}}/analytics.db
# Secrets: LoadCredential=wechat:/etc/{{.Name}}/wechat.secret and reference file:%d/wechat
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/{{.Name}}
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=768M

[Install]
WantedBy=multi-user.target
