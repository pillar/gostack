# /etc/systemd/system/{{.Name}}.service — review before installing.
# Installed by deploy/install.sh, which also creates /etc/{{.Name}}/gostack.env
# (GOSTACK_ENVIRONMENT, database paths) used here and by the deploy scripts.
[Unit]
Description={{.Name}} (GoStack)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{.Name}}
Group={{.Name}}
StateDirectory={{.Name}}
WorkingDirectory=/var/lib/{{.Name}}
ExecStart=/opt/{{.Name}}/current/{{.Name}} --config /etc/{{.Name}}/gostack.yaml serve
# `systemctl reload` re-reads config; only hot keys apply (see `config validate`).
ExecReload=/bin/kill -HUP $MAINPID
EnvironmentFile=/etc/{{.Name}}/gostack.env
# Secrets: LoadCredential=wechat:/etc/{{.Name}}/wechat.secret and reference file:%d/wechat
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/{{.Name}}
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=768M

[Install]
WantedBy=multi-user.target
