# {{.Name}} configuration. Precedence: defaults < this file < GOSTACK_* env < --set.
# SIGHUP (`systemctl reload`) applies only hot keys: log.level, http.max_concurrent,
# game.auth_rate_per_minute, game.score_rate_per_minute, auth.web.ip_rate_per_minute,
# auth.web.account_rate_per_minute. Everything else needs a restart; a reload
# logs such changes without applying them. `config validate` lists the hot keys.
profile: lite
environment: development
http:
  listen: 127.0.0.1:8080
  # internal_listen: 127.0.0.1:9090   # /metrics and pprof; never expose publicly
  max_body_bytes: 1048576
  request_timeout: 10s
database:
  driver: sqlite
  path: data/app.db
  analytics_path: data/analytics.db
  read_connections: 2
  write_connections: 1
  synchronous: FULL
  busy_timeout: 5s
# Profile scale (several instances, PostgreSQL; see GoStack docs/adr/0003-postgres-scale.md):
#   profile: scale
#   database: {driver: postgres, dsn_ref: "env:DATABASE_URL", max_open_connections: 10, read_connections: 4}
#   queue: {driver: postgres}
#   rate_limit: {accept_per_instance: true}   # limiters are per instance; no global limiter yet
# The PostgreSQL database must use LC_COLLATE 'C'. Copy existing SQLite data with
# `migrate to-postgres --from data/app.db --to-dsn-ref env:DATABASE_URL`.
cache:
  driver: memory
  max_bytes: 33554432
queue:
  driver: sqlite
  workers: 2
backup:
  enabled: false
  driver: litestream
log:
  level: info
  format: json
{{if .Game}}kits: [game]
game:
  session_ttl: 24h
  save_max_bytes: 65536
  save_slots_per_player: 5
  settlement:
    interval: 5m                 # enqueue season settlement jobs; 0 disables
  # Optional GameKit feature packages (see GoStack docs/api/*.md):
  # modules: [ops, experiments, social, match, commerce, realtime]
  # commerce:
  #   apple:
  #     root_ca_file: secrets/AppleRootCA-G3.pem   # download and verify from apple.com yourself
  #     apps: { {{.Name}}: { bundle_id: com.example.{{.Name}}, environments: [Production] } }
  #   ads:
  #     admob: { kind: admob }
  # realtime:
  #   max_connections: 4000
{{else}}kits: []
{{end}}
# Optional email/password login with cookie sessions (/v1/auth/*); see GoStack docs/SECURITY.md.
# auth:
#   web:
#     enabled: true
#     session_ttl: 168h
#     idle_timeout: 24h
#     allow_signup: true
#     allowed_origins: []          # extra https origins allowed to call with cookies
#     ip_rate_per_minute: 30
#     account_rate_per_minute: 10
#     max_concurrent_hashes: 2     # Argon2id uses 19 MiB per hash

# Optional billing ledger (/v1/billing/*, API keys with scope "billing").
# billing:
#   enabled: true
# Optional object storage (local disk with signed URLs, or S3-compatible such as R2).
# storage:
#   driver: s3
#   max_object_bytes: 104857600
#   s3:
#     endpoint: https://<account>.r2.cloudflarestorage.com
#     region: auto
#     bucket: {{.Name}}
#     access_key_id_ref: env:R2_ACCESS_KEY_ID
#     secret_access_key_ref: env:R2_SECRET_ACCESS_KEY
#     path_style: true
